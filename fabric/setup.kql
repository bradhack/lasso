// Lasso insights: the table the Eventstream fills. Run once in the KQL database "lasso":
// click anywhere inside the command below (not on these comment lines) and choose Run.
// One flat row per event: event_kind is "story", "answer" or "agent_run" ("kind" is a reserved word in KQL);
// columns that don't apply stay empty.

.execute database script <|
.create-merge table LassoEvents (ts: datetime, event_kind: string, match_id: string, home: string, away: string, minute: int, score: string, moment_id: string, trigger: string, headline: string, p_home: real, p_draw: real, p_away: real, swing: real, ask_id: string, lang: string, persona: string, mode: string, source: string, latency_ms: long, agents: int, runs: int, tokens: long, tool_calls: int, tools: string, checks: int, fixes: string, fix_count: int, timeouts: int, recoveries: int, parent_kind: string, parent_id: string, agent: string, ms: long, ok: bool, error: string, stage: int, model: string, tokens_in: long, tokens_out: long, reasoning: long, hedge: bool, retry: bool, recovered: bool)
.create-or-alter table LassoEvents ingestion json mapping "LassoEventsMapping" '[{"column":"ts","Properties":{"Path":"$.ts"}},{"column":"event_kind","Properties":{"Path":"$.event_kind"}},{"column":"match_id","Properties":{"Path":"$.match_id"}},{"column":"home","Properties":{"Path":"$.home"}},{"column":"away","Properties":{"Path":"$.away"}},{"column":"minute","Properties":{"Path":"$.minute"}},{"column":"score","Properties":{"Path":"$.score"}},{"column":"moment_id","Properties":{"Path":"$.moment_id"}},{"column":"trigger","Properties":{"Path":"$.trigger"}},{"column":"headline","Properties":{"Path":"$.headline"}},{"column":"p_home","Properties":{"Path":"$.p_home"}},{"column":"p_draw","Properties":{"Path":"$.p_draw"}},{"column":"p_away","Properties":{"Path":"$.p_away"}},{"column":"swing","Properties":{"Path":"$.swing"}},{"column":"ask_id","Properties":{"Path":"$.ask_id"}},{"column":"lang","Properties":{"Path":"$.lang"}},{"column":"persona","Properties":{"Path":"$.persona"}},{"column":"mode","Properties":{"Path":"$.mode"}},{"column":"source","Properties":{"Path":"$.source"}},{"column":"latency_ms","Properties":{"Path":"$.latency_ms"}},{"column":"agents","Properties":{"Path":"$.agents"}},{"column":"runs","Properties":{"Path":"$.runs"}},{"column":"tokens","Properties":{"Path":"$.tokens"}},{"column":"tool_calls","Properties":{"Path":"$.tool_calls"}},{"column":"tools","Properties":{"Path":"$.tools"}},{"column":"checks","Properties":{"Path":"$.checks"}},{"column":"fixes","Properties":{"Path":"$.fixes"}},{"column":"fix_count","Properties":{"Path":"$.fix_count"}},{"column":"timeouts","Properties":{"Path":"$.timeouts"}},{"column":"recoveries","Properties":{"Path":"$.recoveries"}},{"column":"parent_kind","Properties":{"Path":"$.parent_kind"}},{"column":"parent_id","Properties":{"Path":"$.parent_id"}},{"column":"agent","Properties":{"Path":"$.agent"}},{"column":"ms","Properties":{"Path":"$.ms"}},{"column":"ok","Properties":{"Path":"$.ok"}},{"column":"error","Properties":{"Path":"$.error"}},{"column":"stage","Properties":{"Path":"$.stage"}},{"column":"model","Properties":{"Path":"$.model"}},{"column":"tokens_in","Properties":{"Path":"$.tokens_in"}},{"column":"tokens_out","Properties":{"Path":"$.tokens_out"}},{"column":"reasoning","Properties":{"Path":"$.reasoning"}},{"column":"hedge","Properties":{"Path":"$.hedge"}},{"column":"retry","Properties":{"Path":"$.retry"}},{"column":"recovered","Properties":{"Path":"$.recovered"}}]'
